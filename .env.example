# Names only. Set these as Windows USER environment variables (see docs/LOCAL_SETUP.md); never commit real values.
CONNECTONE_DB_PASSWORD=<local connectone_app password>
CONNECTONE_JWT_SECRET=<random string, 32+ chars (optional: random per run if unset)>
CONNECTONE_SEED_PASSWORD=<12+ chars; login password of every synthetic dataset account>
CONNECTONE_SEED_ENABLED=false
CONNECTONE_CACHE_TYPE=none
CONNECTONE_REDIS_HOST=localhost
CONNECTONE_REDIS_PORT=6380
CONNECTONE_PORT=18080
